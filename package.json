{
  "name": "maket",
  "version": "2.0.0",
  "mcpName": "io.github.ng-galien/maket-server",
  "description": "Visual design tool for AI assistants — compose posters, flyers, labels, social posts with PDF export",
  "license": "MIT",
  "author": "Alexandre Boyer",
  "homepage": "https://github.com/ng-galien/maket#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ng-galien/maket.git"
  },
  "bugs": {
    "url": "https://github.com/ng-galien/maket/issues"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:client": "npm run build -w @maket/client",
    "starters:build": "tsx scripts/make-starter-bundles.ts",
    "build:pages": "npm run starters:build && npm run build:pages -w @maket/client && node scripts/sync-pages.mjs",
    "pack:npm": "node scripts/pack-npm.ts --pack",
    "test:package": "npm run pack:npm && node scripts/test-npm-package.mjs",
    "start": "npx tsx packages/server/index.ts",
    "dev": "node scripts/dev.mjs dev",
    "dev:watch": "node scripts/dev.mjs dev:watch",
    "dev:server": "node scripts/dev.mjs dev:server",
    "dev:client": "npm run dev -w @maket/client",
    "desktop": "node scripts/desktop.mjs",
    "start:isolated": "node scripts/dev.mjs start:isolated",
    "lint": "biome check packages/",
    "lint:fix": "biome check --write packages/",
    "typecheck": "tsc -b packages/shared packages/runtime packages/agent-setup packages/server packages/stdio-bridge packages/client packages/desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:badge": "node scripts/coverage-badge.mjs",
    "smell:rules": "code-moniker rules show . --default-rules off",
    "smell:review": "scripts/run-smell-review.sh . .code-moniker.toml",
    "changelog:draft": "node scripts/changelog-draft.mjs",
    "test:e2e": "npm run build:client && npm run test:e2e -w @maket/client",
    "test:e2e:coverage": "node scripts/run-e2e-coverage.mjs",
    "e2e:server": "node scripts/dev.mjs e2e:server",
    "quality": "npm run lint && npm run smell:review && npm run typecheck && npm run test:coverage && npm run version:check",
    "version:check": "node scripts/check-versions.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@modelcontextprotocol/client": "^2.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "c8": "^12.0.0",
    "esbuild": "^0.28.1",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jszip": "^3.10.1",
    "lefthook": "^2.1.10",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2",
    "v8-to-istanbul": "^9.3.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "electron-winstaller@5.4.4": true,
    "fs-xattr@0.3.1": true,
    "lefthook@2.1.10": true,
    "macos-alias@0.2.12": true,
    "puppeteer@25.5.0": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
