# Maket — Environment variables
# Copy to .env and fill in your values

# Server
MAKET_PORT=3333          # HTTP/WS port (0 = random)
# MAKET_DATA_DIR=~/.maket  # User data directory (default: ~/.maket)
# MAKET_DB=                # SQLite database path (default: DATA_DIR/documents.db)
# MAKET_TITLE=Maket        # App name in UI

# Google OAuth (for Gmail integration)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (type: Web application)
# 3. Add redirect URI: http://localhost:3333/auth/google/callback
# 4. Copy client_id and client_secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
