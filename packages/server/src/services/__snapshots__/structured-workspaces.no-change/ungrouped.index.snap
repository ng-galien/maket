    "id": "00000000-0000-4000-8000-000000000009",
    "name": "Template",
    "html": "<style data-maket-compact-style=\"00000000-0000-4000-8000-000000000005-0\">[data-maket-compact-template=\"00000000-0000-4000-8000-000000000005-0\"] .maket-card{display:flex;flex-direction:column;gap:1.5mm;padding:4mm;border:1px solid var(--charte-color-line,#d1d5db);border-radius:2mm;font-family:var(--charte-font-body,system-ui,sans-serif)}[data-maket-compact-template=\"00000000-0000-4000-8000-000000000005-0\"] .maket-card strong{font-size:4.5mm}[data-maket-compact-template=\"00000000-0000-4000-8000-000000000005-0\"] .maket-card span{font-size:3.5mm;color:var(--charte-color-muted,#64748b)}</style><style>.maket-index{box-sizing:border-box;padding:5mm;font-family:var(--charte-font-body,system-ui,sans-serif);color:var(--charte-color-text,#1f2937)}.maket-index h1{margin:0 0 4mm;font-size:6mm}.maket-index__items{display:grid;grid-template-columns:minmax(0,1fr);gap:2.5mm}.maket-index__items>[data-maket-structured-group]{margin-top:2mm;font-size:3.5mm;font-weight:600;color:var(--charte-color-muted,#64748b)}</style><main data-id=\"index\" class=\"maket-index\"><h1 data-id=\"index-title\">Items</h1><section data-id=\"index-items\" class=\"maket-index__items\" data-maket-structured-items=\"\"><article data-maket-compact-template=\"00000000-0000-4000-8000-000000000005-0\" style=\"cursor:pointer\" tabindex=\"0\" role=\"button\" data-maket-document=\"Ungrouped item 1\" data-maket-action=\"open-document\" data-id=\"structured-items-1-0-0-card\"><article data-id=\"structured-items-1-0-0-card\" class=\"maket-card\" data-maket-compact-root=\"\"><strong data-id=\"structured-items-1-0-0-card-title\">Item 01</strong><span data-id=\"structured-items-1-0-0-card-status\">Status: doing</span><span data-id=\"structured-items-1-0-0-card-priority\">Priority: 7</span></article></article><article data-maket-compact-template=\"00000000-0000-4000-8000-000000000005-0\" style=\"cursor:pointer\" tabindex=\"0\" role=\"button\" data-maket-document=\"Ungrouped item 2\" data-maket-action=\"open-document\" data-id=\"structured-items-2-0-0-card\"><article data-id=\"structured-items-2-0-0-card\" class=\"maket-card\" data-maket-compact-root=\"\"><strong data-id=\"structured-items-2-0-0-card-title\">Item 02</strong><span data-id=\"structured-items-2-0-0-card-status\">Status: done</span><span data-id=\"structured-items-2-0-0-card-priority\">Priority: 4</span></article></article><article data-maket-compact-template=\"00000000-0000-4000-8000-000000000005-0\" style=\"cursor:pointer\" tabindex=\"0\" role=\"button\" data-maket-document=\"Ungrouped item 3\" data-maket-action=\"open-document\" data-id=\"structured-items-3-0-0-card\"><article data-id=\"structured-items-3-0-0-card\" class=\"maket-card\" data-maket-compact-root=\"\"><strong data-id=\"structured-items-3-0-0-card-title\">Item 03</strong><span data-id=\"structured-items-3-0-0-card-status\">Status: todo</span><span data-id=\"structured-items-3-0-0-card-priority\">Priority: 1</span></article></article><article data-maket-compact-template=\"00000000-0000-4000-8000-000000000005-0\" style=\"cursor:pointer\" tabindex=\"0\" role=\"button\" data-maket-document=\"Ungrouped item 4\" data-maket-action=\"open-document\" data-id=\"structured-items-4-0-0-card\"><article data-id=\"structured-items-4-0-0-card\" class=\"maket-card\" data-maket-compact-root=\"\"><strong data-id=\"structured-items-4-0-0-card-title\">Item 04</strong><span data-id=\"structured-items-4-0-0-card-status\">Status: doing</span><span data-id=\"structured-items-4-0-0-card-priority\">Priority: 8</span></article></article><article data-maket-compact-template=\"00000000-0000-4000-8000-000000000005-0\" style=\"cursor:pointer\" tabindex=\"0\" role=\"button\" data-maket-document=\"Ungrouped item 5\" data-maket-action=\"open-document\" data-id=\"structured-items-5-0-0-card\"><article data-id=\"structured-items-5-0-0-card\" class=\"maket-card\" data-maket-compact-root=\"\"><strong data-id=\"structured-items-5-0-0-card-title\">Item 05</strong><span data-id