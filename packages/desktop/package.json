{
  "name": "@maket/desktop",
  "productName": "Maket",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": ".desktop/main.mjs",
  "license": "MIT",
  "scripts": {
    "build": "node ../../scripts/build-desktop-icons.mjs && node ../../scripts/build-desktop.mjs",
    "prestart": "npm run build",
    "start": "node ../../scripts/start-desktop.mjs",
    "prepackage": "npm run build",
    "package": "electron-forge package",
    "premake": "npm run build",
    "make": "electron-forge make",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@maket/runtime": "*",
    "@maket/server": "*",
    "@maket/shared": "*",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@types/node": "^26.1.2",
    "electron": "^43.4.1",
    "typescript": "^7.0.2"
  }
}
