{
  "name": "maket-app",
  "productName": "Maket",
  "version": "2.0.0",
  "description": "Desktop application for Maket",
  "author": "Alexandre Boyer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ng-galien/maket.git"
  },
  "private": true,
  "type": "module",
  "main": ".desktop/main.mjs",
  "license": "MIT",
  "scripts": {
    "build": "node ../../scripts/build-desktop-icons.mjs && node ../../scripts/build-claude-desktop-mcpb.mjs && node ../../scripts/build-desktop.mjs",
    "build:client": "npm run build -w @maket/client",
    "clean:install-output": "node ../../scripts/clean-desktop-install-output.mjs",
    "prestart": "npm run build",
    "start": "node ../../scripts/start-desktop.mjs",
    "prepackage": "node ../../scripts/assert-desktop-node.mjs && npm run build:client && npm run build",
    "package": "electron-forge package",
    "premake": "node ../../scripts/assert-desktop-node.mjs && npm run build:client && npm run build",
    "make": "electron-forge make",
    "make:install": "node ../../scripts/assert-desktop-node.mjs && npm run build:client && npm run build && npm run clean:install-output && MAKET_INSTALL_BUILD=1 electron-forge make",
    "publish": "node ../../scripts/assert-desktop-node.mjs && npm run build:client && npm run build && electron-forge publish",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@maket/agent-setup": "*",
    "@maket/runtime": "*",
    "@maket/server": "*",
    "@maket/shared": "*",
    "electron-squirrel-startup": "^1.0.1",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.1.2",
    "electron": "^43.4.1",
    "typescript": "^7.0.2"
  }
}
